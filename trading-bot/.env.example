# Alpaca 대시보드(https://app.alpaca.markets)에서 발급한 키
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# 기본은 모의투자(paper). 실전으로 바꾸려면 아래 두 줄을 모두 바꿔야 함
ALPACA_PAPER=true
LIVE_TRADING_CONFIRM=

# 전략 설정
SYMBOLS=SPY,QQQ
SHORT_WINDOW=20
LONG_WINDOW=50
# 종목당 최대 매수 금액(USD)
MAX_POSITION_USD=500
# 하루 계좌 손실이 이 금액을 넘으면 신규 매수 중단(USD)
MAX_DAILY_LOSS_USD=100
